# // Reference:
# // https://www.better-auth.com/docs/installation

NEXT_PUBLIC_HOSTNAME=pnl-lochness-dev.partners.org:3000

PG_host=pnl-postgres-1.partners.org
PG_user=pipeline
PG_password=piedpiper
PG_database=lochnessdb_v1
PG_port=5432

# Optional isolated forms database connection.
# If omitted, app falls back to PG_* and uses FORMS_PG_database/formsdb.
FORMS_PG_host=pnl-postgres-1.partners.org
FORMS_PG_user=pipeline
FORMS_PG_password=piedpiper
FORMS_PG_database=formsdb
FORMS_PG_port=5432

BETTER_AUTH_SECRET=<RANDOM_SECRET>
BETTER_AUTH_URL=http://pnl-lochness-dev.partners.org:3000

NEXT_PUBLIC_AIRFLOW_URL=http://<AIRFLOW_HOST>:<PORT>
AIRFLOW_USERNAME=<AIRFLOW_USERNAME>
AIRFLOW_PASSWORD=<AIRFLOW_PASSWORD>